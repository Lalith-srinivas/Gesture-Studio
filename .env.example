# Gesture Studio - Firebase Configuration Template
# Duplicate this file to '.env' and fill in your actual credentials.
# Vite exposes variables prefixed with VITE_ to client-side code via import.meta.env

# Firebase Web API Key
VITE_FIREBASE_API_KEY=your_api_key_here

# Firebase Auth Domain (e.g. your-project.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Firebase Project ID
VITE_FIREBASE_PROJECT_ID=your_project_id

# Firebase Storage Bucket URL
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# Firebase Cloud Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Firebase App ID
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Measurement ID for Google Analytics
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
