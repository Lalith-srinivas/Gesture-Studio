rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read on leaderboards, write for authenticated users
    match /leaderboards/{board}/entries/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow reading and reserving unique usernames
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow reading and writing user profile & subcollections
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{allChildren=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Default rule for all other documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
